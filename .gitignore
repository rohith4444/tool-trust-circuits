# Python
__pycache__/
*.py[cod]
*.egg-info/

# uv / virtualenvs
.venv*/
uv.lock

# Generated traces -- live on the RunPod volume and a private HF dataset repo,
# never in git.
outputs/
data/raw/
*.jsonl
*.jsonl.gz

# ...but data/ holds ATTC's released benchmark files, which we DO commit (8.6 MB)
# so the repo reproduces standalone. We use their files rather than fetching from
# source because the reproduction gate has to score the same records they scored --
# these benchmarks have several public variants with different subsets and answer
# normalisation.
!data/**/*.jsonl
!data/**/*.json

# Model weights -- pulled from HF to the volume cache, never stored here
hf_cache/
*.safetensors
*.bin

# Local
.DS_Store
.env

# Downloaded HF artifacts -- pairs, judge labels, circuits, results. Never committed.
hf_data/

# Paper draft -- lives in Overleaf, which is the authoritative copy. Keeping a second
# copy in git means two sources of truth and merge conflicts in .tex nobody wants.
paper/
